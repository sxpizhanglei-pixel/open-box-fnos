<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <name>Open-Box</name>
  <app_id>open-box</app_id>
  <version>1.0.0</version>
  <revision>1</revision>
  <arch>x86_64</arch>
  <type>compose</type>
  <developer>Open-Box &amp; FnOS Community</developer>
  <description>基于 sing-box 内核与 Web 控制台的一体化代理面板（自动同步 Open-Box 上游）</description>
  <category>network</category>
  <min_fnos_version>1.2.0</min_fnos_version>
  <web_ui>
    <port>9090</port>
    <path>/</path>
    <protocol>http</protocol>
  </web_ui>
  <compose>
    <image>ghcr.io/sxpizhanglei-pixel/open-box-fnos:latest</image>
    <network_mode>host</network_mode>
    <cap_add>NET_ADMIN,SYS_ADMIN</cap_add>
    <devices>/dev/net/tun:/dev/net/tun</devices>
    <env>TZ=Asia/Shanghai</env>
    <env>SECRET=openbox123</env>
    <volumes>/vol1/1000/docker/open-box/config:/etc/sing-box</volumes>
    <volumes>/vol1/1000/docker/open-box/ui:/app/ui</volumes>
    <restart>always</restart>
    <container_name>open-box</container_name>
  </compose>
</manifest>
