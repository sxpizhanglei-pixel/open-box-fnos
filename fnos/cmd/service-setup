#!/bin/bash

# Open-Box service-setup (fnOS lifecycle hooks for docker app)
# fnOS 安装器自动管理容器生命周期(main start/stop 直接 exit 0)
# 这里只负责: 安装后初始化数据目录 + 写默认配置

LOG_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.log"
COMPOSE_FILE="${TRIM_APPDEST}/docker/docker-compose.yaml"

service_postinst() {
    # 初始化数据目录
    mkdir -p "${TRIM_PKGVAR}/config" 2>/dev/null || true
    mkdir -p "${TRIM_PKGVAR}/ui" 2>/dev/null || true

    # 首次安装写默认 sing-box 配置(不覆盖用户已有配置)
    if [ ! -f "${TRIM_PKGVAR}/config/config.json" ]; then
        if [ -f "${TRIM_APPDEST}/config/config.json" ]; then
            cp "${TRIM_APPDEST}/config/config.json" "${TRIM_PKGVAR}/config/config.json"
            install_log "Seeded default sing-box config from package"
        else
            # 包内无默认配置时写一个最小可用配置
            cat > "${TRIM_PKGVAR}/config/config.json" <<'EOF'
{
  "log": { "level": "info", "timestamp": true },
  "experimental": {
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "/app/ui",
      "secret": "openbox123"
    }
  },
  "inbounds": [
    { "type": "mixed", "tag": "mixed-in", "listen": "0.0.0.0", "listen_port": 2080 }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct" }
  ]
}
EOF
            install_log "Wrote minimal default sing-box config"
        fi
    fi

    # 默认 UI 占位(容器内 Yacd UI 由镜像提供)
    if [ ! -f "${TRIM_PKGVAR}/ui/index.html" ]; then
        echo '<!DOCTYPE html><html><head><title>Open-Box</title></head><body><h1>Open-Box 控制台</h1><p>容器启动后此处由 sing-box external_ui 提供 Yacd 界面</p></body></html>' > "${TRIM_PKGVAR}/ui/index.html"
    fi
}

service_postupgrade() {
    # 升级时保留用户配置,只补齐缺失目录
    mkdir -p "${TRIM_PKGVAR}/config" "${TRIM_PKGVAR}/ui" 2>/dev/null || true
}

service_preuninst() {
    # 卸载前停止并清理容器(保留用户数据)
    if [ -f "${COMPOSE_FILE}" ]; then
        if docker compose version >/dev/null 2>&1; then
            docker compose -f "${COMPOSE_FILE}" down 2>/dev/null || true
        else
            docker-compose -f "${COMPOSE_FILE}" down 2>/dev/null || true
        fi
    fi
}
